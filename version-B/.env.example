# Backend Server
FLASK_ENV=development
FLASK_HOST=localhost
FLASK_PORT=5000
SSL_CERT_PATH=./backend/data/ssl/cert.pem
SSL_KEY_PATH=./backend/data/ssl/key.pem

# CORS (allow add-in to call API)
CORS_ORIGINS=https://localhost:3000,https://outlook.office365.com

# AI Configuration
# Set AI_PROVIDER to 'ollama', 'goa', 'gemini', or 'groq'
AI_PROVIDER=gemini
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# GoA LLM Cluster (only needed if AI_PROVIDER=goa)
GOA_MODEL_ENDPOINT=https://your-goa-endpoint.gov.ab.ca
GOA_API_PATH=/v1/chat/completions
GOA_MODEL=openai/gpt-oss-120b
GOA_API_KEY=your_goa_api_key_here

# Google Gemini (only needed if AI_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Groq (only needed if AI_PROVIDER=groq)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Database
DATABASE_PATH=./backend/data/database.db

# Security
SECRET_KEY=change_this_in_production
DEBUG=True
